PORT=3000
NODE_ENV=development

# Local MySQL settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=portfolio_db

# Use this key in the X-Admin-Key header for admin API requests.
# Change it to a long random value before deployment.
ADMIN_KEY=change-this-to-a-long-random-secret
